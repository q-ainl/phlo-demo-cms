@ extends: entity

static table = 'attachments'
static order = 'created DESC'

view: $this->title

static schema => arr (
	id:      field (type: 'number',   title: 'ID', list: false, record: false, create: false, change: false),
	article: field (type: 'parent',   obj: 'article', title: 'Article', required: true),
	title:   field (type: 'text',     title: 'Title', length: 120),
	file:    field (type: 'file',     title: 'File'),
	created: field (type: 'datetime', title: 'Added'),
)
